{
  "version": 2,
  "builds": [
    {
      "src": "24EG105G63/Backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "24EG105G63/Frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "24EG105G63/Frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "24EG105G63/Backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "24EG105G63/Frontend/dist/$1"
    }
  ]
}
